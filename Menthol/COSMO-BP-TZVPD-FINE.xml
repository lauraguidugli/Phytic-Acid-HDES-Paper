	<periodic dim=""/>
    <levelOfTheory>DFT</levelOfTheory>
    <ri>on</ri>
    <dftSettings>
	<functional>b-p</functional>
	<gridsize>m3</gridsize>
	<disp>0</disp>
	</dftSettings>
    <scfConvergenceParameter>
        <maxIterations>200</maxIterations>
        <energy>6</energy>
        <density/>
    </scfConvergenceParameter>
	<scfDamp>
         <start>0.700</start>
         <min>0.100</min>
         <step>0.050</step>
      </scfDamp>
	<scfDynpol/>
	<plotOrbitals/>
    <cosmo cavity="Fine" epsilon="" filename="out_fine" filetype="cosmo" remove_inner_cavity="0">on</cosmo>
